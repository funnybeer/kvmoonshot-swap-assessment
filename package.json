{
  "name": "@kvmoonshot/swap-assessment",
  "version": "0.5.0",
  "private": true,
  "description": "KVMoonShot Chain cross-chain exchange web interface",
  "scripts": {
    "preinstall": "node scripts/check-engine.js",
    "postinstall": "node scripts/sync-native-bindings.js",
    "predev": "node scripts/sync-native-bindings.js",
    "prestart": "node scripts/sync-native-bindings.js",
    "prebuild": "node scripts/sync-native-bindings.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "ethers": "^6.13.4",
    "lucide-react": "^0.468.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0",
    "zod": "^3.23.8",
    "@kvmoonshot/swap-toolchain": "1.2.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "npm@10.9.8"
